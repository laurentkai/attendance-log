# Copy this file to .env for local Docker Compose development.
# Replace every change_me or replace_with value; never commit .env.
PORT=3000
DATABASE_URL=postgresql://attendance:change_me@localhost:5432/attendance
DATABASE_SSL=false
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
SESSION_SECRET=replace_with_a_long_random_value
