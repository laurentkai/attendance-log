# Copy this file to .env for local Docker Compose development.
# Replace every change_me or replace_with value; never commit .env.
BIND_ADDRESS=0.0.0.0
PORT=3000
NODE_ENV=development
# Canonical public URL used in administrator invitation e-mails (no trailing path).
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://attendance:change_me@localhost:5432/attendance
DATABASE_SSL=false
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change_me
SESSION_SECRET=replace_with_a_long_random_value
# Optional Base64-encoded 256-bit deployment key. Leave empty to use the persistent key file.
APP_ENCRYPTION_KEY=
# Local non-container runs may override the key-file location. Compose uses /app-secrets/encryption.key.
APP_ENCRYPTION_KEY_FILE=/app-secrets/encryption.key
# Optional local non-container override. Compose persists this file in app_secrets.
APP_INSTANCE_ID_FILE=/app-secrets/instance-id
# IANA timezone used for daily and weekly backup schedules.
BACKUP_TIMEZONE=Europe/Brussels
# Maximum accepted Restore V1 upload size in megabytes.
BACKUP_RESTORE_MAX_MB=512
